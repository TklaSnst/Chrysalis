[Default]
# куда «Сохранить» кладёт отредактированный снимок — рядом с исходными
save_dir=$HOME/Pictures/Screenshots
save_filename_format=%Y-%m-%d_%H-%M-%S-edit.png
show_panel=true
line_size=5
text_size=20
text_font=JetBrains Mono
paint_mode=brush
# после копирования/сохранения сразу закрыться
early_exit=true
fill_shape=false
