def kitty(t):
    conf = f"""# {HEADER}
# {t['name']}
background {t['bg']}
foreground {t['fg']}
cursor {t['fg']}
selection_background {t['surface2']}
selection_foreground {t['fg']}
color0 {t['black']}
color1 {t['red']}
color2 {t['green']}
color3 {t['yellow']}
color4 {t['blue']}
color5 {t['magenta']}
color6 {t['cyan']}
color7 {t['white']}
color8 {t['bright_black']}
color9 {t['red']}
color10 {t['green']}
color11 {t['yellow']}
color12 {t['blue']}
color13 {t['magenta']}
color14 {t['cyan']}
color15 {t['bright_white']}
active_tab_background {t['accent']}
active_tab_foreground {t['bg']}
inactive_tab_background {t['surface']}
inactive_tab_foreground {t['fg_dim']}
"""
    write(CFG / "kitty/theme.conf", conf)
    kc = CFG / "kitty/kitty.conf"
    if not kc.exists() or "include theme.conf" not in kc.read_text():
        with open(kc, "a") as f:
            f.write("\ninclude theme.conf\n")
    # живая перезагрузка открытых kitty
    subprocess.run(["pkill", "-USR1", "-x", "kitty"], check=False)


def gtk(t):
    light = t["mode"] == "light"
    # libadwaita/GTK4 именованные цвета + те же для GTK3 (Adwaita их читает частично)
    css = f"""/* {HEADER} */
/* {t['name']} */
@define-color accent_color {t['accent']};
@define-color accent_bg_color {t['accent']};
@define-color accent_fg_color {t['bg'] if not light else '#ffffff'};
@define-color window_bg_color {t['bg']};
@define-color window_fg_color {t['fg']};
@define-color view_bg_color {t['bg_alt'] if not light else '#ffffff'};
@define-color view_fg_color {t['fg']};
@define-color headerbar_bg_color {t['bg_alt']};
@define-color headerbar_fg_color {t['fg']};
@define-color headerbar_border_color {t['surface']};
@define-color headerbar_backdrop_color @window_bg_color;
@define-color sidebar_bg_color {t['bg_alt']};
@define-color sidebar_fg_color {t['fg']};
@define-color sidebar_backdrop_color @window_bg_color;
@define-color card_bg_color {t['surface'] if not light else '#ffffff'};
@define-color card_fg_color {t['fg']};
@define-color dialog_bg_color {t['bg_alt']};
@define-color dialog_fg_color {t['fg']};
@define-color popover_bg_color {t['bg_alt']};
@define-color popover_fg_color {t['fg']};
@define-color destructive_color {t['red']};
@define-color destructive_bg_color {t['red']};
@define-color success_color {t['green']};
@define-color warning_color {t['yellow']};
@define-color error_color {t['red']};
@define-color borders {t['surface']};
@define-color theme_bg_color {t['bg']};
@define-color theme_fg_color {t['fg']};
@define-color theme_base_color {t['bg_alt'] if not light else '#ffffff'};
@define-color theme_text_color {t['fg']};
@define-color theme_selected_bg_color {t['accent']};
@define-color theme_selected_fg_color {t['bg'] if not light else '#ffffff'};
"""
    write(CFG / "gtk-3.0/gtk.css", css)
    write(CFG / "gtk-4.0/gtk.css", css)
    scheme = "prefer-light" if light else "prefer-dark"
    theme = "Adwaita" if light else "Adwaita-dark"
    for key, val in (("color-scheme", scheme), ("gtk-theme", theme)):
        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", key, val], check=False)
    # GTK3-приложения без портала читают settings.ini
    ini = CFG / "gtk-3.0/settings.ini"
    write(ini, f"[Settings]\ngtk-theme-name={theme}\ngtk-icon-theme-name={ICON_THEME}\n"
               f"gtk-application-prefer-dark-theme={0 if light else 1}\n")


# Оттенки синего в папках Adwaita: (цвет, роль). Перекрашиваем в акцент темы,
# сохраняя относительную светлоту каждого оттенка.
ADWAITA_FOLDER = ["#438de6", "#62a0ea", "#a4caee", "#afd4ff", "#c0d5ea"]
ADWAITA_MAIN = "#62a0ea"
ICON_THEME = "ThemeAccent"


def _hls(h):
    import colorsys
    r, g, b = (c / 255 for c in hexrgb(h))
    return colorsys.rgb_to_hls(r, g, b)


def _from_hls(h, l, s):
    import colorsys
    r, g, b = colorsys.hls_to_rgb(h, max(0, min(1, l)), max(0, min(1, s)))
    return "#%02x%02x%02x" % (round(r * 255), round(g * 255), round(b * 255))


def icons(t):
    """Тема иконок ~/.local/share/icons/ThemeAccent: Adwaita + папки в цвете акцента."""
    src = Path("/usr/share/icons/Adwaita/scalable")
    if not src.is_dir():
        return
    dst = HOME / ".local/share/icons" / ICON_THEME
    ah, al, as_ = _hls(t["accent"])
    _, ml, ms = _hls(ADWAITA_MAIN)
    table = {}
    for c in ADWAITA_FOLDER:
        _, l, sat = _hls(c)
        table[c] = _from_hls(ah, al + (l - ml), as_ * (sat / ms if ms else 1))
    files = list((src / "places").glob("folder*.svg")) + list((src / "places").glob("user-*.svg")) \
        + [src / "status/folder-open.svg"]
    for f in files:
        rel = f.relative_to(src)
        svg = f.read_text()
        if not any(c in svg for c in table):
            continue
        for old, new in table.items():
            svg = svg.replace(old, new)
        out = dst / "scalable" / rel
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text(svg)
        # мелкие растровые размеры рендерим из перекрашенного svg
        try:
            import gi
            gi.require_version("GdkPixbuf", "2.0")
            from gi.repository import GdkPixbuf
            for size in (16, 24, 32):
                pb = GdkPixbuf.Pixbuf.new_from_file_at_size(str(out), size, size)
                png = dst / f"{size}x{size}" / rel.with_suffix(".png")
                png.parent.mkdir(parents=True, exist_ok=True)
                pb.savev(str(png), "png", [], [])
        except Exception:
            pass
    dirs = ["scalable/places", "scalable/status"] + [f"{n}x{n}/places" for n in (16, 24, 32)] \
        + [f"{n}x{n}/status" for n in (16, 24, 32)]
    index = [f"[Icon Theme]\nName={ICON_THEME}\nComment={HEADER}\nInherits=Adwaita,hicolor\n"
             f"Directories={','.join(dirs)}\n"]
    for d in dirs:
        size = "16" if d.startswith("scalable") else d.split("x")[0]
        typ = "Scalable\nMinSize=8\nMaxSize=512" if d.startswith("scalable") else "Fixed"
        index.append(f"[{d}]\nSize={size}\nContext={'Places' if 'places' in d else 'Status'}\nType={typ}\n")
    write(dst / "index.theme", "\n".join(index))
    subprocess.run(["gtk-update-icon-cache", "-f", "-q", str(dst)], check=False)
    for f in dst.rglob("*"):
        if f.is_dir():
            os.utime(f)  # GTK следит за mtime каталогов темы
    subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "icon-theme", ICON_THEME], check=False)


def btop(t):
    """btop: themes/chrysalis.theme + color_theme в btop.conf.
    Работающий btop перечитывает конфиг по SIGUSR2."""
    grad = lambda name, a, b, c: "".join(
        f'theme[{name}_{k}]="{v}"\n' for k, v in (("start", a), ("mid", b), ("end", c)))
    theme = f"""# {HEADER}
# {t['name']}
theme[main_bg]="{t['bg']}"
theme[main_fg]="{t['fg']}"
theme[title]="{t['fg_bright']}"
theme[hi_fg]="{t['accent']}"
theme[selected_bg]="{t['surface']}"
theme[selected_fg]="{t['fg_bright']}"
theme[inactive_fg]="{t['fg_dim']}"
theme[graph_text]="{t['fg_dim']}"
theme[meter_bg]="{t['surface']}"
theme[proc_misc]="{t['accent2']}"
theme[cpu_box]="{t['surface2']}"
theme[mem_box]="{t['surface2']}"
theme[net_box]="{t['surface2']}"
theme[proc_box]="{t['surface2']}"
theme[div_line]="{t['surface2']}"
""" + grad("temp", t["green"], t["yellow"], t["red"]) \
      + grad("cpu", t["accent"], t["accent2"], t["red"]) \
      + grad("free", t["green"], t["cyan"], t["accent"]) \
      + grad("cached", t["blue"], t["accent"], t["cyan"]) \
      + grad("available", t["yellow"], t["orange"], t["red"]) \
      + grad("used", t["accent2"], t["magenta"], t["red"]) \
      + grad("download", t["blue"], t["accent"], t["cyan"]) \
      + grad("upload", t["magenta"], t["accent2"], t["red"]) \
      + grad("process", t["accent"], t["accent2"], t["red"])
    write(CFG / "btop/themes/chrysalis.theme", theme)

    conf = CFG / "btop/btop.conf"
    text = conf.read_text() if conf.exists() else ""
    line = 'color_theme = "chrysalis"'
    if re.search(r"(?m)^color_theme\s*=", text):
        text = re.sub(r"(?m)^color_theme\s*=.*$", line, text)
    else:
        text = line + "\n" + text  # остальное btop допишет сам при выходе
    conf.write_text(text)
    subprocess.run(["pkill", "-USR2", "-x", "btop"], check=False)


def cava(t):
    """cava: тема-градиент themes/chrysalis + theme = 'chrysalis' в [color].
    Работающий cava перечитывает цвета по SIGUSR2."""
    stops = []
    for c in (t["blue"], t["accent"], t["cyan"], t["accent2"], t["magenta"]):
        if c.lower() not in (x.lower() for x in stops):  # у многих тем accent2 == blue
            stops.append(c)
    theme = f"# {HEADER}\n# {t['name']}\n[color]\ngradient = 1\n" + "".join(
        f"gradient_color_{i} = '{c}'\n" for i, c in enumerate(stops, 1))
    write(CFG / "cava/themes/chrysalis", theme)

    conf = CFG / "cava/config"
    text = conf.read_text() if conf.exists() else "[color]\n"
    line = "theme = 'chrysalis'"
    if re.search(r"(?m)^\s*theme\s*=", text):
        text = re.sub(r"(?m)^\s*theme\s*=.*$", line, text)
    elif re.search(r"(?m)^\[color\]", text):
        text = re.sub(r"(?m)^\[color\][ \t]*$", "[color]\n" + line, text, count=1)
    else:
        text += "\n[color]\n" + line + "\n"
    conf.write_text(text)
    subprocess.run(["pkill", "-USR2", "-x", "cava"], check=False)


VSCODE_DIRS = ("Code", "Code - OSS", "VSCodium", "Cursor")


def _jsonc(text):
    """settings.json у VS Code — JSONC: убираем // и /* */ комментарии
    (не трогая строки) и висячие запятые."""
    text = re.sub(r'("(?:\\.|[^"\\])*")|//[^\n]*|/\*.*?\*/',
                  lambda m: m.group(1) or "", text, flags=re.S)
    text = re.sub(r",(\s*[}\]])", r"\1", text)
    return json.loads(text) if text.strip() else {}


def vscode(t):
    """VS Code / VSCodium: базовая тема по режиму + workbench.colorCustomizations.

    Ключи workbench.colorTheme и workbench.colorCustomizations принадлежат
    theme-apply и перезаписываются; остальные настройки не трогаются.
    VS Code следит за settings.json и перекрашивается сразу."""
    light = t["mode"] == "light"
    a = lambda c, alpha: c + alpha  # #rrggbb + AA
    colors = {
        "focusBorder": t["accent"],
        "foreground": t["fg"],
        "descriptionForeground": t["fg_dim"],
        "textLink.foreground": t["blue"],
        "button.background": t["accent"],
        "button.foreground": t["bg"],
        "badge.background": t["accent"],
        "badge.foreground": t["bg"],
        "progressBar.background": t["accent"],
        "input.background": t["surface"],
        "input.foreground": t["fg"],
        "input.border": t["surface2"],
        "dropdown.background": t["surface"],
        "dropdown.foreground": t["fg"],
        "list.activeSelectionBackground": t["surface"],
        "list.activeSelectionForeground": t["fg_bright"],
        "list.inactiveSelectionBackground": t["surface"],
        "list.hoverBackground": a(t["surface"], "80"),
        "list.highlightForeground": t["accent"],
        "editor.background": t["bg"],
        "editor.foreground": t["fg"],
        "editorCursor.foreground": t["accent"],
        "editor.selectionBackground": a(t["accent"], "40"),
        "editor.lineHighlightBackground": t["bg_alt"],
        "editorLineNumber.foreground": t["fg_dim"],
        "editorLineNumber.activeForeground": t["fg_bright"],
        "editorIndentGuide.background1": t["surface"],
        "editorWidget.background": t["bg_alt"],
        "editorGroupHeader.tabsBackground": t["bg_alt"],
        "editorGroup.border": t["surface"],
        "tab.activeBackground": t["bg"],
        "tab.activeForeground": t["fg_bright"],
        "tab.activeBorderTop": t["accent"],
        "tab.inactiveBackground": t["bg_alt"],
        "tab.inactiveForeground": t["fg_dim"],
        "tab.border": t["bg_alt"],
        "sideBar.background": t["bg_alt"],
        "sideBar.foreground": t["fg"],
        "sideBarSectionHeader.background": t["bg_alt"],
        "activityBar.background": t["bg_alt"],
        "activityBar.foreground": t["accent"],
        "activityBar.inactiveForeground": t["fg_dim"],
        "activityBarBadge.background": t["accent"],
        "activityBarBadge.foreground": t["bg"],
        "titleBar.activeBackground": t["bg_alt"],
        "titleBar.activeForeground": t["fg"],
        "titleBar.inactiveBackground": t["bg_alt"],
        "titleBar.inactiveForeground": t["fg_dim"],
        "statusBar.background": t["bg_alt"],
        "statusBar.foreground": t["fg_dim"],
        "statusBar.noFolderBackground": t["bg_alt"],
        "statusBar.debuggingBackground": t["orange"],
        "statusBar.debuggingForeground": t["bg"],
        "panel.background": t["bg"],
        "panel.border": t["surface"],
        "quickInput.background": t["bg_alt"],
        "scrollbarSlider.background": a(t["surface2"], "80"),
        "scrollbarSlider.hoverBackground": t["surface2"],
        "minimap.background": t["bg"],
        "terminal.background": t["bg"],
        "terminal.foreground": t["fg"],
        "terminalCursor.foreground": t["accent"],
    }
    for name, key in (("Black", "black"), ("Red", "red"), ("Green", "green"),
                      ("Yellow", "yellow"), ("Blue", "blue"), ("Magenta", "magenta"),
                      ("Cyan", "cyan"), ("White", "white")):
        colors[f"terminal.ansi{name}"] = t[key]
        bright = {"black": "bright_black", "white": "bright_white"}.get(key, key)
        colors[f"terminal.ansiBright{name}"] = t[bright]

    for app in VSCODE_DIRS:
        user = CFG / app / "User"
        if not user.parent.is_dir():
            continue
        path = user / "settings.json"
        text = path.read_text() if path.exists() else ""
        try:
            settings = json.loads(text) if text.strip() else {}
        except ValueError:
            # JSONC: при перезаписи комментарии пропадут — сохраняем оригинал один раз
            try:
                settings = _jsonc(text)
            except ValueError as e:
                print(f"theme-apply: vscode: не разобрать {path}: {e}", file=sys.stderr)
                continue
            backup = path.with_name("settings.json.bak")
            if not backup.exists():
                backup.write_text(text)
        settings["workbench.colorTheme"] = "Default Light Modern" if light else "Default Dark Modern"
        settings["workbench.colorCustomizations"] = colors
        user.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps(settings, indent=4, ensure_ascii=False) + "\n")


FIREFOX_ROOTS = (
    HOME / ".mozilla/firefox",
    HOME / "snap/firefox/common/.mozilla/firefox",          # Ubuntu snap
    HOME / ".var/app/org.mozilla.firefox/.mozilla/firefox",  # flatpak
)
FIREFOX_PREF = 'user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);'
FIREFOX_IMPORT = '@import url("chrysalis.css");'


def _firefox_profiles():
    for root in FIREFOX_ROOTS:
        ini = root / "profiles.ini"
        if not ini.exists():
            continue
        for section in re.split(r"(?m)^(?=\[)", ini.read_text()):
            if not section.startswith("[Profile"):
                continue
            path = re.search(r"(?m)^Path=(.+)$", section)
            if not path:
                continue
            relative = re.search(r"(?m)^IsRelative=1$", section)
            p = root / path.group(1) if relative else Path(path.group(1))
            if p.is_dir():
                yield p


def firefox(t):
    """Firefox userChrome: панели, вкладки и адресная строка в цветах темы.

    Пишет chrome/chrysalis.css, подключает его первой строкой userChrome.css
    (свой userChrome.css не затирается) и включает чтение userChrome
    в user.js. Firefox применит после перезапуска."""
    light = t["mode"] == "light"
    sel_fg = t["fg_bright"] if not light else t["fg"]
    css = f"""/* {HEADER} */
/* {t['name']} */
:root {{
    --lwt-accent-color: {t['bg_alt']} !important;
    --lwt-text-color: {t['fg']} !important;
    --toolbar-bgcolor: {t['bg']} !important;
    --toolbar-color: {t['fg']} !important;
    --toolbarbutton-icon-fill: {t['fg']} !important;
    --tab-selected-bgcolor: {t['surface']} !important;
    --tab-selected-textcolor: {sel_fg} !important;
    --tab-hover-background-color: {rgba(t['surface'], 0.6)} !important;
    --toolbar-field-background-color: {t['bg_alt']} !important;
    --toolbar-field-color: {t['fg']} !important;
    --toolbar-field-focus-background-color: {t['surface']} !important;
    --toolbar-field-focus-color: {sel_fg} !important;
    --toolbar-field-focus-border-color: {t['accent']} !important;
    --urlbarView-highlight-background: {t['surface']} !important;
    --urlbarView-highlight-color: {sel_fg} !important;
    --arrowpanel-background: {t['bg_alt']} !important;
    --arrowpanel-color: {t['fg']} !important;
    --arrowpanel-border-color: {t['surface']} !important;
    --sidebar-background-color: {t['bg_alt']} !important;
    --sidebar-text-color: {t['fg']} !important;
    --focus-outline-color: {t['accent']} !important;
    --button-primary-bgcolor: {t['accent']} !important;
    --button-primary-color: {t['bg']} !important;
    --color-accent-primary: {t['accent']} !important;
}}
#navigator-toolbox, #TabsToolbar, #titlebar {{
    background-color: {t['bg_alt']} !important;
    color: {t['fg']} !important;
}}
#nav-bar, #PersonalToolbar {{
    background-color: {t['bg']} !important;
}}
.tab-background:is([selected], [multiselected]) {{
    background: {t['surface']} !important;
    box-shadow: inset 0 -2px 0 {t['accent']} !important;
}}
"""
    for profile in _firefox_profiles():
        chrome = profile / "chrome"
        write(chrome / "chrysalis.css", css)
        uc = chrome / "userChrome.css"
        old = uc.read_text() if uc.exists() else ""
        if FIREFOX_IMPORT not in old:
            # @import обязан стоять до любых правил
            uc.write_text(f"/* цвета Chrysalis (theme-apply) */\n{FIREFOX_IMPORT}\n\n{old}")
        prefs = profile / "user.js"
        old = prefs.read_text() if prefs.exists() else ""
        if FIREFOX_PREF not in old:
            prefs.write_text(old + ("" if not old or old.endswith("\n") else "\n") + FIREFOX_PREF + "\n")


def fastfetch(t):
    """~/.config/fastfetch/config.jsonc: цвета темы, короткий список модулей, рамка.

    Правая грань рамки держится на выравнивании значений до фиксированной ширины
    ({N<W} в format) — поэтому у каждого модуля формат задан явно."""
    import getpass

    def ansi(h):
        r, g, b = hexrgb(h)
        return f"38;2;{r};{g};{b}"
    acc, acc2, fgc, mute = ansi(t["accent"]), ansi(t["accent2"]), ansi(t["fg"]), ansi(t["fg_dim"])
    KEYW, VALW = 18, 40                       # ширина ключа и значения
    inner = KEYW + VALW                       # ширина ключа у fastfetch включает separator
    edge = f"{{#{acc}}}│"

    def sect(title):
        return {"type": "custom", "format": f"{{#{acc}}}├─ {{#{acc2}}}{title} {{#{acc}}}{'─' * (inner - len(title) - 5)}┤"}

    def mod(typ, icon, key, fmt, **extra):
        m = {"type": typ, "key": f"{{#{acc}}}│ {{#{acc2}}}{icon}  {{#{fgc}}}{key}",
             "format": f"{{#{fgc}}}{fmt}{edge}"}
        m.update(extra)
        return m

    user = getpass.getuser()
    cfg = {
        "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
        "logo": {
            "type": "file",
            "source": str(CFG / "fastfetch/logo.txt"),
            "color": {"1": acc, "2": acc2},
            "padding": {"top": 2, "left": 1, "right": 3},
        },
        "display": {
            "separator": "  ",
            "key": {"width": KEYW},
            "color": {"keys": acc, "title": acc2, "output": fgc},
        },
        "modules": [
            {"type": "custom", "format": f"{{#{acc}}}╭{'─' * (inner - 2)}╮"},
            mod("title", "󰀄", "user", f"{{#{acc2}}}{{1}}{{#{mute}}}@{{#{fgc}}}{{2<{VALW - len(user) - 1}}}"),
            sect("system"),
            mod("os", "󰌽", "os", f"{{3<{VALW}}}"),
            mod("kernel", "󰒋", "kernel", f"{{2<{VALW}}}"),
            mod("wm", "󰖟", "wm", f"{{2<9}}{{5<{VALW - 9}}}"),
            mod("uptime", "󰥔", "uptime", "{1>2}d {2>2}h {3>2}m" + " " * (VALW - 11)),
            mod("packages", "󰏖", "packages", "{4<5} dpkg" + " " * (VALW - 10)),
            mod("shell", "󰆍", "shell", f"{{3<4}}{{4<{VALW - 4}}}"),
            sect("hardware"),
            mod("cpu", "󰻠", "cpu", f"{{1<{VALW}}}"),
            mod("gpu", "󰢮", "gpu", f"{{2<{VALW}}}"),
            mod("memory", "󰍛", "memory", "{1>9} / {2>10} ({3})" + " " * (VALW - 28)),
            mod("disk", "󰋊", "disk", "{1>9} / {2>10} ({3}) {9<7}" + " " * (VALW - 36), folders="/"),
            mod("battery", "󰁹", "battery", f"{{4>3}}% {{5<{VALW - 5}}}", percent={"type": 1}),
            {"type": "custom", "format": f"{{#{acc}}}╰{'─' * (inner - 2)}╯"},
            {"type": "colors", "symbol": "circle", "paddingLeft": 3},
        ],
    }
    write(CFG / "fastfetch/config.jsonc", f"// {HEADER}\n// {t['name']}\n" + json.dumps(cfg, indent=2, ensure_ascii=False) + "\n")


def kdeglobals(t):
    """Qt/KDE (dolphin и т.п.): переписываем только секции Colors:* и General."""
    light = t["mode"] == "light"
    fg = t["fg"]

    def sec(name, bg, alt, text):
        return f"""[Colors:{name}]
BackgroundNormal={','.join(map(str, hexrgb(bg)))}
BackgroundAlternate={','.join(map(str, hexrgb(alt)))}
ForegroundNormal={','.join(map(str, hexrgb(text)))}
ForegroundInactive={','.join(map(str, hexrgb(t['fg_dim'])))}
ForegroundActive={','.join(map(str, hexrgb(t['accent'])))}
ForegroundLink={','.join(map(str, hexrgb(t['blue'])))}
ForegroundVisited={','.join(map(str, hexrgb(t['magenta'])))}
ForegroundNegative={','.join(map(str, hexrgb(t['red'])))}
ForegroundNeutral={','.join(map(str, hexrgb(t['yellow'])))}
ForegroundPositive={','.join(map(str, hexrgb(t['green'])))}
DecorationFocus={','.join(map(str, hexrgb(t['accent'])))}
DecorationHover={','.join(map(str, hexrgb(t['accent'])))}
"""
    view_bg = t["bg_alt"] if not light else "#ffffff"
    block = "\n".join([
        f"[General]\nColorScheme={t['name'].replace(' ', '')}\nName={t['name']}\n",
        sec("Window", t["bg"], t["bg_alt"], fg),
        sec("View", view_bg, t["bg"], fg),
        sec("Button", t["surface"], t["surface2"], fg),
        sec("Selection", t["accent"], t["accent2"], t["bg"] if not light else "#ffffff"),
        sec("Tooltip", t["bg_alt"], t["surface"], fg),
        sec("Complementary", t["bg_alt"], t["surface"], fg),
        sec("Header", t["bg_alt"], t["surface"], fg),
    ])
    p = CFG / "kdeglobals"
    old = p.read_text() if p.exists() else ""
    # выкидываем старые секции General и Colors:*
    parts = re.split(r"(?m)^(?=\[)", old)
    keep = [s for s in parts if s.strip() and not re.match(r"\[(General|Colors:)", s)]
    write(p, block + "\n" + "".join(keep))


def reload_apps():
    # Вне сессии Hyprland (инсталлятор, TTY, другой DE) только пишем файлы:
    # иначе waybar поднялся бы поверх чужого рабочего стола
    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return
    subprocess.run(["hyprctl", "reload"], check=False, capture_output=True)
    # SIGUSR2 (перечитать CSS) у этого waybar роняет его в segfault на tray,
    # поэтому перезапускаем целиком через обёртку с повторами
    subprocess.run(["pkill", "-f", "^/bin/sh .*waybar-autostart"], check=False)
    subprocess.run(["pkill", "-x", "waybar"], check=False)
    for _ in range(40):  # ждём, пока старый waybar реально выйдет
        if subprocess.run(["pgrep", "-x", "waybar"], capture_output=True).returncode != 0:
            break
        time.sleep(0.05)
    subprocess.Popen(["setsid", "-f", str(HOME / ".local/bin/waybar-autostart")],
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(["swaync-client", "--reload-css"], check=False, capture_output=True)
    # swayosd читает стиль только при старте
    if subprocess.run(["pkill", "-x", "swayosd-server"], capture_output=True).returncode == 0:
        subprocess.Popen(["setsid", "-f", "swayosd-server"], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# ------------------------------------------------------------------ main

def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    if argv[0] == "--list":
        for tid, name, mode in list_themes():
            print(f"{tid}\t{name}\t{mode}")
        return 0
    if argv[0] == "--current":
        print(CURRENT.read_text().strip() if CURRENT.exists() else "")
        return 0
    if argv[0] == "--opacity":
        OPACITY.write_text(argv[1] + "\n")
        cur = CURRENT.read_text().strip() if CURRENT.exists() else "nord"
        hypr(load(cur))
        subprocess.run(["hyprctl", "reload"], check=False, capture_output=True)
        return 0
    if argv[0] == "--contrast":
        CONTRAST.write_text(argv[1] + "\n")
        cur = CURRENT.read_text().strip() if CURRENT.exists() else "nord"
        return main([cur, "--quiet"])

    t = load(argv[0])
    for step in (hypr, waybar, swaync, wofi, swayosd, alacritty, kitty, gtk, icons, fastfetch, kdeglobals,
                 vscode, firefox, btop, cava):
        try:
            step(t)
        except Exception as e:  # одна сломанная цель не должна валить остальные
            print(f"theme-apply: {step.__name__}: {e}", file=sys.stderr)
    CURRENT.write_text(t["id"] + "\n")
    reload_apps()
    if "--quiet" not in argv:
        subprocess.run(["notify-send", "-a", "Тема", "-i", "preferences-desktop-theme",
                        f"Тема: {t['name']}", "Применена ко всей системе"], check=False)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
