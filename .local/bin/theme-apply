#!/usr/bin/env python3
"""Применяет цветовую тему ко всей системе.

    theme-apply <id>        применить тему ~/.config/themes/<id>.json
    theme-apply --list      список тем (id<TAB>название<TAB>режим)
    theme-apply --current   id текущей темы
    theme-apply --contrast N  задать усиление контраста 0..1 (по умолчанию 0.6)
                              и переприменить текущую тему
    theme-apply --opacity N   прозрачность окон 0.3..1 (1 — непрозрачные);
                              меняет только Hyprland, без перезапуска панели

Контраст: фон тёмных тем тянется к чёрному, текст — к белому (для светлых
наоборот), акценты не трогаются. Значение хранится в ~/.config/themes/contrast.

Что переписывается:
  hypr/theme.conf, waybar/colors/colors.css, swaync/colors/colors.css,
  wofi/colors.css, swayosd/style.css, alacritty/theme.toml, kitty/theme.conf,
  gtk-3.0/gtk.css, gtk-4.0/gtk.css, kdeglobals (только секции Colors:*),
  ~/.local/share/icons/ThemeAccent (Adwaita с папками в цвете акцента),
  fastfetch/config.jsonc,
  VS Code / VSCodium settings.json (workbench.colorTheme + colorCustomizations),
  Firefox chrome/chrysalis.css, подключённый из userChrome.css (после перезапуска),
  btop/themes/chrysalis.theme, cava/themes/chrysalis (+ выбор темы в их конфигах),
  gsettings color-scheme/gtk-theme (Firefox и Chromium следуют за ними).
"""
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

HOME = Path.home()
CFG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
THEMES = CFG / "themes"
CURRENT = THEMES / "current"
CONTRAST = THEMES / "contrast"
DEFAULT_CONTRAST = 0.6
OPACITY = THEMES / "opacity"

HEADER = "Сгенерировано theme-apply, не редактировать — правьте JSON в ~/.config/themes"


def hexrgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def rgba(h, a):
    r, g, b = hexrgb(h)
    return f"rgba({r}, {g}, {b}, {a})"


def mix(a, b, k):
    ra, rb = hexrgb(a), hexrgb(b)
    return "#%02x%02x%02x" % tuple(round(ra[i] * (1 - k) + rb[i] * k) for i in range(3))


def contrast_level():
    try:
        return min(1.0, max(0.0, float(CONTRAST.read_text().strip())))
    except (OSError, ValueError):
        return DEFAULT_CONTRAST


def window_opacity():
    try:
        return min(1.0, max(0.3, float(OPACITY.read_text().strip())))
    except (OSError, ValueError):
        return 1.0


def boost(t, k):
    """Усиливает контраст палитры: фоны к чёрному/белому, текст — в обратную сторону."""
    if k <= 0:
        return t
    t = dict(t)
    light = t["mode"] == "light"
    far_bg, far_fg = ("#ffffff", "#000000") if light else ("#000000", "#ffffff")
    for key, amount in (("bg", 0.8), ("bg_alt", 0.8), ("surface", 0.5), ("surface2", 0.35), ("black", 0.6)):
        t[key] = mix(t[key], far_bg, k * amount)
    for key, amount in (("fg", 0.5), ("fg_bright", 0.8), ("fg_dim", 0.35),
                        ("white", 0.35), ("bright_white", 0.6)):
        t[key] = mix(t[key], far_fg, k * amount)
    return t


def load(tid):
    p = THEMES / f"{tid}.json"
    if not p.exists():
        sys.exit(f"нет темы {tid}: {p}")
    return boost(json.load(open(p)), contrast_level())


def list_themes():
    out = []
    for p in sorted(THEMES.glob("*.json")):
        t = json.load(open(p))
        out.append((t["id"], t["name"], t["mode"]))
    return out


def write(path, text):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.is_symlink():
        path.unlink()
    path.write_text(text)


# ---------------------------------------------------------------- targets

def hypr(t):
    lines = [f"# {HEADER}", f"# Тема: {t['name']}"]
    for k in ("bg", "bg_alt", "surface", "surface2", "fg", "fg_dim", "fg_bright",
              "accent", "accent2", "red", "orange", "yellow", "green", "cyan", "blue", "magenta"):
        lines.append(f"${k} = rgb({t[k].lstrip('#')})")
    # прозрачность окон (theme-apply --opacity), её берёт decoration в hyprland.conf
    lines.append(f"$window_opacity = {window_opacity():g}")
    # полупрозрачные фоны — для «стеклянных» элементов hyprlock
    for k in ("bg", "surface"):
        lines.append(f"${k}_glass = rgba({t[k].lstrip('#')}b3)")
    write(CFG / "hypr/theme.conf", "\n".join(lines) + "\n")


def waybar(t):
    css = f"""/* {HEADER} */
/* {t['name']} */

@define-color module-bg     {rgba(t['bg_alt'], 0.9)};
@define-color tooltip-bg    @module-bg;
@define-color inactive      {t['fg_dim']};
@define-color fg            {t['fg']};
@define-color workspace-fg  @fg;

@define-color red           {t['red']};
@define-color blue          {t['accent']};
@define-color yellow        {t['yellow']};
@define-color green         {t['green']};
"""
    write(CFG / "waybar/colors/colors.css", css)


def swaync(t):
    css = f"""/* {HEADER} */
/* {t['name']} */
@define-color center-bg                 {rgba(t['bg'], 0.8)};
@define-color notification-bg           {rgba(t['bg'], 0.9)};
@define-color center-notification-bg    {t['bg_alt']};
@define-color background                {rgba(t['bg'], 0.9)};
@define-color background-alt            {t['bg_alt']};
@define-color text                      {t['fg']};
@define-color text-alt                  {t['fg_dim']};
@define-color selected                  alpha(@text-alt, .4);
@define-color hover                     alpha(@selected, .4);
@define-color urgent                    {t['red']};
"""
    write(CFG / "swaync/colors/colors.css", css)


def wofi(t):
    light = t["mode"] == "light"
    css = f"""/* {HEADER} */
/* {t['name']} */
@define-color base      {t['bg']};
@define-color surface   {t['surface'] if not light else t['bg']};
@define-color text      {t['fg']};
@define-color text-dim  {t['fg_dim']};
@define-color text-sel  {t['fg_bright'] if not light else t['fg']};
@define-color accent    {t['accent']};
@define-color red       {t['red']};
@define-color warm      {t['orange']};
@define-color yellow    {t['yellow']};
@define-color green     {t['green']};
@define-color cool      {t['cyan']};
@define-color blue      {t['blue']};
@define-color purple    {t['magenta']};
/* блик и тёмная грань стекла */
@define-color glass-hi  {'#ffffff' if light else t['fg_bright']};
@define-color glass-lo  {t['fg'] if light else t['bg']};
"""
    write(CFG / "wofi/colors.css", css)
    # wofi грузит стиль как строку, и относительный @import ищется от
    # текущей папки (обычно ~), а не от style.css — тогда цвета не
    # определены, фон не рисуется и стекла нет. Пишем абсолютный путь.
    imp = f'@import url("{CFG / "wofi/colors.css"}");'
    for name in ("style.css", "style-wallpaper.css"):
        f = CFG / "wofi" / name
        if f.exists():
            s = f.read_text()
            s2 = re.sub(r'^@import url\("[^"]*colors\.css"\);', imp, s, count=1, flags=re.M)
            if s2 != s:
                f.write_text(s2)


def swayosd(t):
    """Стиль OSD громкости/яркости — стекло в цветах темы, как у wofi."""
    light = t["mode"] == "light"
    hi = "#ffffff" if light else t["fg_bright"]
    css = f"""/* {HEADER} */
/* {t['name']} */
window#osd {{
    border-radius: 999px;
    border: 1px solid {rgba(hi, 0.18)};
    background: {rgba(t['surface'] if not light else t['bg'], 0.55)};
    box-shadow: inset 0 1px 0 {rgba(hi, 0.35)};
}}
window#osd #container {{ margin: 14px 18px; }}
window#osd image, window#osd label {{ color: {t['fg_bright'] if not light else t['fg']}; }}
window#osd progressbar:disabled, window#osd image:disabled {{ opacity: 0.45; }}
window#osd progressbar, window#osd segmentedprogress {{
    min-height: 6px; border-radius: 999px; background: transparent; border: none;
}}
window#osd trough, window#osd segment {{
    min-height: inherit; border-radius: inherit; border: none;
    background: {rgba(t['fg_dim'], 0.35)};
}}
window#osd progress, window#osd segment.active {{
    min-height: inherit; border-radius: inherit; border: none;
    background: {t['accent']};
}}
window#osd segment {{ margin-left: 8px; }}
window#osd segment:first-child {{ margin-left: 0; }}
"""
    write(CFG / "swayosd/style.css", css)


