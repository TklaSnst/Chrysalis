#!/bin/sh
# Меню питания (главное меню → «Питание»). Выход, перезагрузка и выключение
# переспрашивают: случайный Enter не должен закрыть все окна.
cfg="${XDG_CONFIG_HOME:-$HOME/.config}/wofi"

menu() {
    wofi --dmenu --conf "$cfg/main" --style "$cfg/style.css" --prompt "$1" \
         --define dmenu-print_line_num=true
}

confirm() {
    [ "$(printf '%s\n' "  Да, $1" "  Отмена" | menu "$1?")" = 0 ]
}

n="$(printf '%s\n' \
    "󰌾   Заблокировать" \
    "󰤄   Сон" \
    "󰍃   Выйти из сессии" \
    "󰜉   Перезагрузить" \
    "󰐥   Выключить" \
    | menu "Питание")"

case "$n" in
    0) exec loginctl lock-session ;;
    # hypridle заблокирует экран перед сном (before_sleep_cmd)
    1) exec systemctl suspend ;;
    2) confirm "выйти" && exec hyprctl dispatch exit ;;
    3) confirm "перезагрузить" && exec systemctl reboot ;;
    4) confirm "выключить" && exec systemctl poweroff ;;
esac
