#!/bin/sh
# Прозрачность окон (Super+O): под полупрозрачными окнами видно размытые
# обои, как у меню и панели. Значение хранится в ~/.config/themes/opacity.
cfg="${XDG_CONFIG_HOME:-$HOME/.config}/wofi"
cur="$(cat "${XDG_CONFIG_HOME:-$HOME/.config}/themes/opacity" 2>/dev/null || echo 1)"

levels="1 0.95 0.9 0.85 0.8 0.7 0.6"
sel="$(for v in $levels; do
        pct="$(awk "BEGIN { printf \"%d\", $v * 100 }")"
        mark=""; [ "$(awk "BEGIN { print ($v == $cur) }")" = 1 ] && mark="  · текущая"
        printf '󰂵   %s%%%s\n' "$pct" "$mark"
    done | wofi --dmenu --conf "$cfg/main" --style "$cfg/style.css" \
                --prompt "Прозрачность окон" --define dmenu-print_line_num=true)"

[ -n "$sel" ] || exit 0
exec "$HOME/.local/bin/theme-apply" --opacity "$(echo "$levels" | cut -d' ' -f$((sel + 1)))"
