# =============================================================================
# Chrysalis — .gitignore
# =============================================================================

# ── Generated by theme-apply ─────────────────────────────────────────────────
.config/hypr/theme.conf
.config/waybar/colors/colors.css
.config/swaync/colors/
.config/wofi/colors.css
.config/alacritty/theme.toml
.config/kitty/theme.conf
.config/fastfetch/config.jsonc
.config/gtk-3.0/
.config/gtk-4.0/
.config/kdeglobals

# ── Machine-specific state ────────────────────────────────────────────────────
.config/themes/current
.config/themes/contrast
.config/wallpapers/current
.config/wallpapers/transition
# generated by wallpaper-gen
.config/wallpapers/theme-*.png

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc

# ── Editor / OS ───────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~
.DS_Store

# ── Backups created by install.sh ─────────────────────────────────────────────
*.bak
*.orig
*.log

# ── Local tooling ─────────────────────────────────────────────────────────────
.claude/
