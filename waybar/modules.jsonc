{
    // =========================================================
    // WORKSPACE & WINDOW
    // =========================================================

    "hyprland/workspaces": {
        "format": "{icon}",
        "on-scroll-down": "hyprctl dispatch workspace e+1",
        "on-scroll-up":   "hyprctl dispatch workspace e-1",
        "persistent-workspaces": { "*": 5 },
        "cursor": true,
        "format-icons": {
            "active":     "󰮯",
            "persistent": "",
            "empty":      ""
        }
    },

    "niri/workspaces": {
        "format": "{icon}",
        "cursor": true,
        "on-scroll-up":   "niri msg action focus-workspace-up",
        "on-scroll-down": "niri msg action focus-workspace-down",
        "hide-empty": true,
        "format-icons": {
            "active":  "󰮯",
            "default": "",
            "empty":   ""
        }
    },

    "hyprland/window": {
        "max-length": 45
    },

    "hyprland/submap": {
        "format": "  {}",
        "max-length": 12,
        "tooltip": false
    },

    // =========================================================
    // SYSTEM METRICS
    // =========================================================

    "cpu": {
        "interval": 30,
        "format": " {usage}%",
        "cursor": true,
        "states": { "warning": 80, "critical": 90 }
    },

    "load": {
        "interval": 30,
        "format": " {load1}",
        "cursor": true
    },

    "memory": {
        "interval": 10,
        "format": "  {used:0.1f}G/{total:0.1f}G",
        "states": { "warning": 80, "critical": 90 }
    },

    "temperature": {
        "interval": 10,
        "format": "{icon} {temperatureC}°",
        "critical-threshold": 90,
        "format-icons": ["","","","",""]
    },

    // =========================================================
    // POWER & BATTERY
    // =========================================================

    "battery": {
        "interval": 20,
        "full-at": 100,
        "tooltip": true,
        "format-full":     "",
        "format":          "{icon} {capacity}%",
        "format-time":     "{H}:{M:02}",
        "format-charging": " {capacity}% ({time})",
        "format-icons":    ["󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂂","󰁹"],
        "states": { "warning": 30, "critical": 15 }
    },

    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}",
        "format-icons": {
            "performance": "",
            "balanced":    "",
            "power-saver": ""
        }
    },

    // =========================================================
    // BACKLIGHT
    // =========================================================

    "backlight": {
        "scroll-step": 2,
        "format": "{icon}",
        "tooltip-format": "{percent}%",
        "format-icons": ["󰃞","󰃝","󰃟","󰃠"]
    },

    "backlight/slider": {
        "min": 5,
        "max": 100,
        "cursor": true
    },

    // =========================================================
    // AUDIO
    // =========================================================

    "pulseaudio": {
        "format":           "{icon}",
        "format-bluetooth": "{icon}",
        "tooltip-format":   "{volume}%",
        "format-muted":     "<span size='12pt'>󰝟</span>",
        "scroll-step": 2,
        "on-click":         "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-click-right":   "pavucontrol -t 4 &",
        "format-icons": {
            "headphone":  "",
            "hands-free": "",
            "headset":    "",
            "phone":      "",
            "portable":   "",
            "car":        "",
            "default": [
                "<span size='12pt'>󰕿</span>",
                "<span size='12pt'>󰖀</span>",
                "<span size='12pt'>󰕾</span>"
            ]
        }
    },

    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "cursor": true,
        "on-click-right": "pavucontrol -t 4 &"
    },

    // =========================================================
    // NETWORK & BLUETOOTH
    // =========================================================

    "network": {
        "interval": 10,
        "format-disabled":    "",
        "format-disconnected": "",
        "format-wifi":        "",
        "format-ethernet":    "",
        "tooltip-format": "{essid}\n\nFrequency: {frequency}GHz\nStrength: {signalStrength}%\n\n{bandwidthUpBytes}   {bandwidthDownBytes}",
        "menu": "on-click-right",
        "menu-file": "~/.config/waybar/context/network.xml",
        "menu-actions": {
            "action-1": "nmcli radio wifi off",
            "action-2": "nmcli radio wifi on",
            "action-3": "kitty -e nmtui &",
            "action-4": "nm-connection-editor &"
        }
    },

    "bluetooth": {
        "format":                    "{}",
        "format-on":                 "󰂰",
        "format-off":                "󰂲",
        "format-disabled":           "󰂲",
        "format-connected":          " {device_alias}",
        "format-connected-battery":  " {device_alias}",
        "tooltip-format":            "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}   {device_battery_percentage}%",
        "on-click":       "~/.local/bin/toggle_bluetooth &",
        "on-click-right": "blueman-manager &"
    },

    "tray": {
        "icon-size": 13,
        "spacing":   12,
        "cursor":    true
    },

    // =========================================================
    // CLOCK
    // =========================================================

    "clock": {
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "format":     "{:%H:%M}",
        "format-alt": "{:%H:%M  %d %b %Y}",
        "calendar": {
            "mode":          "year",
            "weeks-pos":     "right",
            "mode-mon-col":  3,
            "format": {
                "months":   "<span color='#acb0d0'><b>{}</b></span>",
                "weeks":    "<span color='#7aa2f7'><b>W{}</b></span>",
                "weekdays": "<span color='#e0af68'><b>{}</b></span>",
                "days":     "<span color='#acb0d0'><b>{}</b></span>",
                "today":    "<span color='#41a6b5'><b><u>{}</u></b></span>"
            }
        }
    },

    // =========================================================
    // MUSIC / MPRIS
    // =========================================================

    "mpris": {
        "format":        "{artist} — {title}",
        "format-paused": " {artist} — {title}",
        "tooltip-format": "{album}",
        "on-click":       "playerctl play-pause",
        "on-scroll-up":   "playerctl previous",
        "on-scroll-down": "playerctl next",
        "max-length": 40
    },

    // =========================================================
    // CAVA EQUALIZER
    // =========================================================

    "custom/cava": {
        "exec":        "~/.config/scripts/cava-waybar.sh",
        "return-type": "json",
        "interval":    "once",
        "format":      "{}",
        "tooltip":     false,
        "on-click":    "pkill -SIGUSR1 cava"
    },

    // =========================================================
    // MUSIC DRAWER CONTROLS
    // =========================================================

    "custom/music-toggle": {
        "format":   "󰝚",
        "tooltip":  false,
        "cursor":   true
    },

    "custom/prev": {
        "format":   "󰒮",
        "tooltip":  false,
        "on-click": "playerctl previous"
    },

    "custom/next": {
        "format":   "󰒭",
        "tooltip":  false,
        "on-click": "playerctl next"
    },

    // =========================================================
    // LOGO / LAUNCHER
    // =========================================================

    "custom/logo": {
        "format":   "󰣇",
        "tooltip":  false,
        "cursor":   true,
        "on-click": "~/.config/rofi/menus/main.sh &"
    },

    // =========================================================
    // POWER BUTTON
    // =========================================================

    "custom/power": {
        "format":   "⏻",
        "tooltip":  false,
        "cursor":   true,
        "on-click": "~/.config/rofi/menus/system.sh &"
    },

    // =========================================================
    // DRAWER ARROWS
    // =========================================================

    "custom/arrow-left":  { "format": "", "tooltip": false, "cursor": true },
    "custom/arrow-right": { "format": "", "tooltip": false, "cursor": true },

    // =========================================================
    // DRAWER GROUPS
    // =========================================================

    "group/group-volume": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration":    600,
            "transition-left-to-right": true,
            "reveal-delay":           450
        },
        "modules": ["pulseaudio", "pulseaudio/slider"]
    },

    "group/group-backlight": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration":    600,
            "transition-left-to-right": true,
            "reveal-delay":           450
        },
        "modules": ["backlight", "backlight/slider"]
    },

    // Music drawer: click the note icon to expand track info + controls
    "group/music": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration":    500,
            "transition-left-to-right": false,
            "click-to-reveal":        true
        },
        "modules": ["custom/music-toggle", "custom/prev", "mpris", "custom/next"]
    },

    // =========================================================
    // CONTROL CENTER CONTEXT MENU
    // =========================================================

    "custom/ctlcenter": {
        "tooltip": false,
        "format":  "",
        "on-click": "swaync-client -t",
        "menu": "on-click-right",
        "menu-file": "~/.config/waybar/context/ctlcenter.xml",
        "menu-actions": {
            "action-1-1": "kitty -e htop &",
            "action-1-2": "kitty -e nvtop &",
            "action-1-3": "kitty -e pkexec powertop &",
            "action-1-4": "missioncenter &",
            "action-2-1": "nwg-look &",
            "action-2-2": "qt6ct &",
            "action-2-3": "kvantummanager &",
            "action-4-1": "~/.local/bin/caffeine shutdown",
            "action-4-2": "~/.local/bin/caffeine handle-lid-switch",
            "action-5":   "~/.local/bin/powersafe",
            "action-6":   "hyprctl reload"
        }
    },

    // App launcher
    "custom/start": {
        "format":   "",
        "tooltip":  false,
        "on-click": "rofi -show drun -theme ~/.config/rofi/theme.rasi &"
    }
}
